/target
.env
.DS_Store
.idea
.serena
CLAUDE.local.md
tmp/
node_modules/
docs/.vitepress/cache
docs/.vitepress/dist
# Generated by `etv-station --render-etv-next` from the station config — never
# authored by hand, so ignore by pattern (channel count can change). The
# committed normalization.default.json and presentation.example.json do NOT
# match these.
examples/etv-next/lineup.json
examples/etv-next/channel*.json
examples/etv-next/presentation.json
examples/output/
# Minted on first run beside the station config. Per-install, and the one value
# a fresh clone must not inherit — a shared tuner id makes two people's servers
# look like the same box to Plex.
.device_id
.device_id.tmp
tools/__pycache__/
# examples/channels/ holds the channels the dev station actually RUNS, and
# examples/station.yaml globs it. Personal channels live here and are ignored;
# only the runnable committed one is tracked. Ignore-then-negate rather than
# naming personal files, so renaming or adding one can't silently leak it into
# the repo (an exact-name ignore breaks the moment the file moves).
#
# Worked sample channels live in examples/samples/ instead — they are test
# fixtures, not station channels. Most are query channels that need a populated
# catalog, so registering them with the dev station would fail it at startup.
# They are tracked wholesale; nothing personal belongs there.
examples/channels/*
!examples/channels/lavfi-test.yaml
examples/blocks/
examples/overlays/marquee_overlay.toml
examples/overlays/showcase_overlay.toml
examples/overlays/scripts/
.claude/scheduled_tasks.lock
*.local.*
# deploy/appdata/ mirrors the deployed container's /config folder. The station
# config, channels, blocks, and overlays in it are personal — same reasoning as
# examples/channels/ above — so only the README and the normalization defaults
# every channel body is built from are tracked. lineup.json / channelN.json are
# generated in the container at each start and rsync'd back by nobody.
deploy/appdata/*
!deploy/appdata/README.md
!deploy/appdata/etv-next/
deploy/appdata/etv-next/*
!deploy/appdata/etv-next/normalization.default.json
tmp-*.log

# Local verify rig — machine-specific, never committed
.claude/skills/verify/
